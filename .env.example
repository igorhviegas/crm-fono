# Config web do Firebase (publica por natureza; a seguranca esta nas regras do Firestore).
# Copie para .env.local e preencha com o projeto Firebase de DESENVOLVIMENTO.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# "true" = usa emuladores locais (sem conta Firebase, so dados ficticios)
VITE_USE_EMULATOR=true
